<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Delta" Height="500" Width="700">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF17005A" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <TextBlock Text="Program obliczający deltę" FontSize="20" FontFamily="Verdana" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,10,0,0" Grid.ColumnSpan="2" Foreground="White"/>
        <TextBlock Text="Podaj a:"  Margin="0,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Height="20" FontSize="16" Grid.Column="1" Foreground="White"/>
        <TextBox x:Name="aLiczba" Margin="0,70,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Height="30" FontSize="16" Grid.Column="1"/>
        <TextBlock Text="Podaj b:"  Margin="0,97,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Height="20" FontSize="16" Grid.Column="1" Foreground="White"/>
        <TextBox x:Name="bLiczba" Margin="0,120,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Height="30" FontSize="16" Grid.Column="1"/>
        <TextBlock Text="Podaj c:"  Margin="0,150,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Height="20" FontSize="16" Grid.Column="1" Foreground="White"/>
        <TextBox x:Name="cLiczba" Margin="0,170,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Height="30" FontSize="16" Grid.Column="1"/>
        <Button Content="Oblicz deltę" Click="Oblicz_Click" VerticalAlignment="Top" HorizontalAlignment="Center" Width="100" Margin="0,220,0,0" Grid.Column="1" Foreground="Black"/>
        <TextBlock x:Name="wynik" Margin="0,250,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="200" Height="30" FontSize="16" Grid.Column="1" Foreground="White"/>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
    </Grid>
</Window>
